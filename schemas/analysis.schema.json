{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "question_item": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", "critical", null] },
            "category": {
              "type": ["string", "null"],
              "enum": ["security", "privacy", "gdpr", "compliance", "functional", "other", null]
            },
            "requires_user_input": { "type": ["boolean", "null"] }
          },
          "required": ["text", "severity", "category", "requires_user_input"]
        }
      ]
    }
  },
  "properties": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "needs_user_input", "blocked"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question_item" } }
      },
      "required": ["status", "reasons", "questions"]
    },
    "task": { "type": "string" },
    "repo_context_summary": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["in_scope", "out_of_scope", "non_goals"]
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "domain": {
            "type": "string",
            "enum": ["security", "privacy", "correctness", "performance", "maintainability", "cost", "compliance"]
          },
          "description": { "type": "string" },
          "mitigations": { "type": "array", "items": { "type": "string" } },
          "blocking": { "type": "boolean" }
        },
        "required": ["id", "severity", "domain", "description", "mitigations", "blocking"]
      }
    },
    "key_files_to_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["path", "reason"]
      }
    },
    "suggested_verification_commands": { "type": "array", "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "gate",
    "task",
    "repo_context_summary",
    "scope",
    "assumptions",
    "risks",
    "key_files_to_review",
    "suggested_verification_commands",
    "stop_conditions"
  ]
}
